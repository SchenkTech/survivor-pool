# Copy to .env (docker compose) or apps/api/.env (npm run dev).

# Public origin people reach the app at. Used for the Google redirect URI:
#   <PUBLIC_URL>/api/auth/google/callback
PUBLIC_URL=https://survivor.example.com

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. Always admins; lets a fresh install's first person in.
ADMIN_EMAILS=you@gmail.com

# Minutes between score syncs (0 = off; admins can still press Sync).
SYNC_INTERVAL_MINUTES=15

# Local development only -- sign in by typing an invited email, no Google.
# Refused when NODE_ENV=production.
# DEV_LOGIN=true
